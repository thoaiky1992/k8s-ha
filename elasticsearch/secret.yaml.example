# Mẫu Secret cho tài khoản elastic. Sao chép sang secret.local.yaml, thay mật khẩu.
# Không commit secret.local.yaml; Kubernetes Secret chỉ mã hóa base64, không mã hóa dữ liệu lưu trữ.
apiVersion: v1
kind: Secret
metadata:
  name: elastic-auth
  namespace: elasticsearch
type: kubernetes.io/basic-auth
stringData:
  username: elastic
  password: thoaiky1992
