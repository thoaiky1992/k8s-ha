# Mẫu Secret chứa thông tin kết nối Debezium. Copy thành postgres-cdc-credentials.secret.yaml
# (đã được .gitignore), thay các giá trị <...> rồi apply. Không commit file thật.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-cdc-credentials
  namespace: kafka
type: Opaque
stringData:
  # Định dạng properties; KafkaConnector đọc từng key bằng ${file:...:key}.
  postgres.properties: |
    database.hostname=<postgres-host>
    database.port=5432
    database.dbname=<database>
    database.user=<debezium-user>
    database.password=<password>
