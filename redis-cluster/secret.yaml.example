# Sao chép thành secret.yaml (file này đã nằm trong .gitignore), thay mật khẩu mạnh rồi mới áp dụng.
# Kubernetes Secret không tự mã hóa dữ liệu lưu trữ trong etcd.
apiVersion: v1
kind: Secret
metadata:
  name: redis-cluster-auth
  namespace: redis-cluster
type: Opaque
stringData:
  redis-password: CHANGE_ME_WITH_A_STRONG_PASSWORD
