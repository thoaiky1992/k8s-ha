# Sao chép thành secret.local.yaml và thay encryption key trước khi áp dụng.
# RedisInsight dùng key này để mã hóa mật khẩu database trong SQLite trên PVC.
apiVersion: v1
kind: Secret
metadata:
  name: redisinsight
  namespace: redisinsight
type: Opaque
stringData:
  encryption-key: CHANGE_ME_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_48
