# Sao chép thành secret.local.yaml, thay mật khẩu mạnh rồi mới áp dụng.
# Kubernetes Secret không tự mã hóa dữ liệu lưu trữ trong etcd.
apiVersion: v1
kind: Secret
metadata:
  name: redis-sentinel-auth
  namespace: redis-sentinel
type: Opaque
stringData:
  redis-password: CHANGE_ME_WITH_A_STRONG_PASSWORD
